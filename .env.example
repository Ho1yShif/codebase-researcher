# Every environment variable the services read. Nothing loads this file automatically: copy it to .env and
# pass it with Node's --env-file, for example `pnpm exec tsx --env-file=.env src/api.ts`. On Render, set
# these on the services instead (see render.yaml and the README's Configuration section).

# ── API service ───────────────────────────────────────────────────────────
API_TOKEN=
# WORKFLOW_SLUG=codebase-researcher-workflow
# WORKFLOW_TASK_SLUG=
# PORT=3000
# RENDER_USE_LOCAL_DEV=true
# RENDER_LOCAL_DEV_URL=http://localhost:8121

# Slack adapter (optional; mount only when both are set)
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# ALLOWED_CHANNEL_IDS=
# SLACK_CALLBACK_KEY=
# Overrides the Slack Web API base URL (rarely needed).
# SLACK_API_URL=
# PUBLIC_URL=

# ── Workflow ─────────────────────────────────────────────────────────────
RENDER_API_KEY=
# RENDER_WORKSPACE_ID=
MODEL_PROVIDER=anthropic
MODEL=claude-opus-5
# Alias for MODEL, used when MODEL is unset.
# PI_MODEL=
# MODEL_API_KEY=
ANTHROPIC_API_KEY=
SANDBOX_PROVIDER=render
SANDBOX_NETWORK_POLICY=allow-list
# SANDBOX_ALLOWED_DOMAINS=api.anthropic.com
# SANDBOX_TIMEOUT_SECONDS=1800
# Minimum gap between Sandbox API calls, for the 100 requests/minute workspace limit.
# RENDER_API_MIN_INTERVAL_MS=1000
# SNAPSHOT_NAME=
# AGENT_TIMEOUT_MS=900000
# SANDBOX_PROVISION_TIMEOUT_MS=300000
# PI_THINKING_LEVEL=medium
# REPOS=render-oss/cli,render-oss/sdk

# ── Snapshot refresh cron ────────────────────────────────────────────────
GITHUB_TOKEN=
# SANDBOX_BUILDER_TIMEOUT_SECONDS=3600

# ── Local development ───────────────────────────────────────────────────
# LOCAL_REPOS_ROOT=.scratch/repos
# LOCAL_SANDBOXES_ROOT=.scratch/sandboxes
# Appended to the auto-bundled runner's command; --faux runs without a model.
# LOCAL_RUNNER_ARGS=--faux
# Replaces the auto-bundled runner entirely.
# LOCAL_RUNNER_CMD=node /abs/path/to/runner.mjs

# ── Tests ────────────────────────────────────────────────────────────────
# With a provider and its key var (e.g. ANTHROPIC_API_KEY) set, `pnpm test` also runs a live smoke test
# of the runner against that provider. LIVE_MODEL overrides the test's default model for it.
# LIVE_MODEL_PROVIDER=anthropic
# LIVE_MODEL=
